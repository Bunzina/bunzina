# Production environment example (DO NOT COMMIT real secrets)
APP_ENV=prod

# Recommended: set a single full DATABASE URL
# Example: postgres://user:password@host:5432/dbname
PROD_DATABASE_URL=postgres://a_definir:a_definir@a_definir:5432/bunzina

# OR set individual variables
# PROD_DB_HOST=a_definir
# PROD_DB_USER=a_definir
# PROD_DB_PASSWORD=a_definir
# PROD_DB_PORT=5432
# PROD_DB_NAME=bunzina

# Email configuration (example for development/testing)
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=1080