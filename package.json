{
  "name": "bunzina",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "docker compose up",
    "start": "bun run src/api/server.ts",
    "start:dev": "bun --hot run src/api/server.ts",
    "start:with-migrations": "bun run migration && bun run start:dev",
    "test": "bun test",
    "test:database": "docker compose up db_test -d",
    "test:integration": "bun run test:database && sleep 2 && bun test --config=./bunfig.integration.toml ./src/test/integration/",
    "posttest:integration": "docker compose stop db_test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "migration": "bun run migrations/engine/index.ts"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14",
    "@lucas-pmelo/fast-validators": "^0.1.0",
    "@lucas-pmelo/handlers": "^0.0.5",
    "@lucas-pmelo/logger": "^0.0.6",
    "@lucas-pmelo/validator": "^0.0.3",
    "dayjs": "^1.11.20",
    "elysia": "^1.4.28",
    "http-status-codes": "^2.3.0",
    "nodemailer": "^8.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "bun-mock-extended": "^3.0.5",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
