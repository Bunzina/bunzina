      "targets": [
        {
          "expr": "sum(rate(bunzina_service_order_status_duration_seconds_sum{job=\"bunzina\",from_status=\"IN_EXECUTION\",to_status=\"COMPLETED\"}[$__range])) / sum(rate(bunzina_service_order_status_duration_seconds_count{job=\"bunzina\",from_status=\"IN_EXECUTION\",to_status=\"COMPLETED\"}[$__range]))",
          "legendFormat": "IN_EXECUTION -> COMPLETED",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "id": 2,
      "title": "Tempo medio por transicao, ao longo do tempo",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (from_status, to_status) (rate(bunzina_service_order_status_duration_seconds_sum{job=\"bunzina\"}[$__rate_interval])) / sum by (from_status, to_status) (rate(bunzina_service_order_status_duration_seconds_count{job=\"bunzina\"}[$__rate_interval]))",
          "legendFormat": "{{from_status}} -> {{to_status}}",
          "refId": "A"
        }
      ]
    },
