      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (from_status, to_status) (rate(bunzina_service_order_status_duration_seconds_count{job=\"bunzina\"}[1h]))",
          "legendFormat": "{{from_status}} -> {{to_status}}",
          "refId": "A"
        }
      ]
    }
