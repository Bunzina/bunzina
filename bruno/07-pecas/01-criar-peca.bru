meta {
  name: Criar peca
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auto-parts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Filtro de oleo",
    "description": "Filtro para oleo do motor",
    "price": 4500,
    "stock": 10
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300 && res.body?.id) {
    bru.setVar("autoPartId", res.body.id);
  }
}
