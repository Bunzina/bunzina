put {
  url: {{baseUrl}}/services/{{serviceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Troca de oleo",
