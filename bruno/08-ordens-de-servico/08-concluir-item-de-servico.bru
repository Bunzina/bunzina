meta {
  name: Concluir item de servico
  type: http
  seq: 8
}

patch {
  url: {{workshopBaseUrl}}/executions/{{serviceOrderId}}/items
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "services": [{ "serviceId": "{{serviceId}}" }]
  }
}

docs {
  Envia os serviceIds da OS. A ordem deve estar em execucao no Workshop.
}
