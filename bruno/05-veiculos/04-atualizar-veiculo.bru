meta {
  name: Atualizar veiculo
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/vehicles/{{vehicleId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": "{{customerId}}",
    "licensePlate": "ABC1D23",
    "model": "Corolla",
    "brand": "Toyota",
    "year": 2020
  }
}
